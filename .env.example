# Copy this file to .env for local development (or set these as
# Environment Variables in your Render dashboard for production).

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DATABASE_URL unset locally to use SQLite automatically.
# On Render, set it to the Internal Database URL of your Postgres instance:
# DATABASE_URL=postgres://user:password@host:5432/dbname

SCHOOL_NAME=Sample Upper Basic & Senior Secondary School
SCHOOL_ADDRESS=The Gambia
SCHOOL_MOTTO=Knowledge, Discipline, Excellence
CURRENT_SESSION=2025/2026

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
